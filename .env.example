# Application
APP_NAME=typhoon-vn-forecast-system
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
SLOW_REQUEST_MS=1000

# Forecast performance controls.
CACHE_ENABLED=false
FORECAST_CACHE_TTL_SECONDS=1800
FORECAST_CACHE_MAX_ENTRIES=1024
INFERENCE_MAX_CONCURRENCY=4

# Filesystem paths (relative to the repository root by default)
DATA_DIR=data
MODEL_REGISTRY_URI=./mlruns
FEATURE_STORE_DIR=data/processed/features

# Local development services. Do not put production credentials in this file.
# OPERATIONAL_DATABASE_URL is the database actually used by the API Store.
OPERATIONAL_DATABASE_URL=sqlite:///data/operational/typhoon.db
DATABASE_URL=postgresql+psycopg://typhoon:typhoon@localhost:5432/typhoon
REDIS_URL=redis://localhost:6379/0

# API authentication. In production configure API_KEY or all OAuth/JWT values.
# Use a random JWT secret of at least 32 characters; never commit real secrets.
REQUIRE_API_KEY=false
API_KEY=
CORS_ORIGINS=[]
JWT_SECRET=
JWT_ISSUER=typhoon-vn
JWT_AUDIENCE=typhoon-vn-api
JWT_EXPIRY_SECONDS=3600
OAUTH_USERNAME=
OAUTH_PASSWORD=
REQUESTS_PER_MINUTE=120
# Keyless local weather provider; review provider terms before public deployment.
ACCUWEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
ACCUWEATHER_BASE_URL=https://dataservice.accuweather.com
# Windy Map Forecast is browser-side; this value is embedded in the frontend bundle.
# Use a Testing key only for development and a Professional key for production.
VITE_WINDY_MAP_API_KEY=
WEATHER_REQUEST_TIMEOUT_SECONDS=8
WEATHER_CURRENT_TTL_SECONDS=600
WEATHER_HOURLY_TTL_SECONDS=1200
WEATHER_DAILY_TTL_SECONDS=7200
WEATHER_ALERTS_TTL_SECONDS=300
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=typhoon-checkpoints

# Optional external providers; leave blank until a later phase.
NCHMF_API_KEY=
WEATHER_PROVIDER_API_KEY=

# Phase 1 source endpoints. These are public data locations unless noted.
CMA_BASE_URL=https://tcdata.typhoon.org.cn/data/CMABSTdata
IBTRACS_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv/ibtracs.WP.list.v04r01.csv
JMA_BEST_TRACK_URL=https://www.jma.go.jp/jma/jma-eng/jma-center/rsmc-hp-pub-eg/Besttracks/bst_all.zip
JTWC_MANIFEST_PATH=
NCHMF_BULLETIN_MANIFEST_PATH=
PCTT_IMPACT_MANIFEST_PATH=
GADM_VIETNAM_URL=https://geodata.ucdavis.edu/gadm/gadm4.1/json/gadm41_VNM_1.json.zip
GSHHG_URL=
OISST_BASE_URL=https://www.ncei.noaa.gov/data/sea-surface-temperature-optimum-interpolation/v2.1/access/avhrr
CDSAPI_URL=
CDSAPI_KEY=
GFS_BASE_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod

# Review the source terms before providing URLs for NCHMF, PCTT, JTWC or GSHHG.
