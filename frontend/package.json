{
    "name": "typhoon-vn-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "verify:pages-output": "node scripts/verify-pages-output.mjs",
        "deploy:pages": "npm run build && npm run verify:pages-output && wrangler pages deploy ../src/typhoon_vn/dashboard --project-name baoviet2026 --commit-dirty=true",
        "preview": "vite preview",
        "lint": "tsc --noEmit",
        "test": "node --test tests/*.test.mjs"
    },
    "dependencies": {
        "leaflet": "^1.9.4",
        "lucide-react": "^1.16.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^9.1.0"
    },
    "devDependencies": {
        "@types/leaflet": "^1.9.12",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.6.1",
        "postcss": "^8.5.28",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.6.3",
        "vite": "^5.4.10",
        "wrangler": "^4.136.0"
    }
}
