server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The public dashboard only needs read access to typhoon data. Inject the
    # preview key inside Nginx so it is never bundled into browser JavaScript.
    location ~ ^/typhoons(/|$) {
        limit_except GET { deny all; }
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key ${API_KEY};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~ ^/(api|token|forecast|health|ready|version|alerts|subscriptions|docs|openapi\.json)(/|$) {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
