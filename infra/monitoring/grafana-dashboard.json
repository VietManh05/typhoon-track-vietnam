{
  "title": "Typhoon VN Operations",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "API uptime",
      "targets": [
        {
          "expr": "typhoon_api_uptime_seconds"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API requests",
      "targets": [
        {
          "expr": "rate(typhoon_api_requests_total[5m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API errors",
      "targets": [
        {
          "expr": "rate(typhoon_api_errors_total[5m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(typhoon_api_request_latency_ms_bucket[5m]))"
        }
      ]
    }
  ]
}
