# Copy to .env.production. Generate new secrets; do not commit that file.
API_KEY=replace-with-random-secret
POSTGRES_USER=typhoon
POSTGRES_PASSWORD=replace-with-url-safe-random-secret
POSTGRES_DB=typhoon
MODEL_HOST_PATH=./checkpoints/promoted
# Create a random monitoring-only token in this local file; never commit it.
METRICS_TOKEN_HOST_FILE=./secrets/metrics_token
SNAPSHOT_HOST_PATH=./data/snapshots
APP_ENV=production
ALLOW_BASELINE=false
REQUIRE_API_KEY=true
MODEL_ARTIFACT=/app/models/promoted
ACCUWEATHER_API_KEY=
WEATHER_PROVIDER=accuweather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Browser-visible Windy Map Forecast key (Professional license for production).
VITE_WINDY_MAP_API_KEY=
